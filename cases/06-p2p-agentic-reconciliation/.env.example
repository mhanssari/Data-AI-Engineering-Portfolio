# Copy to .env in this folder (ignored by Git) and change the passwords.
# These are local-only development values for containers bound to 127.0.0.1. Never put real credentials here.

# 127.0.0.1, not localhost: containers bind IPv4 only, and on Windows localhost tries ::1 first and stalls.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=p2p
POSTGRES_USER=p2p_admin
POSTGRES_PASSWORD=change-me-local-only
# The login people and agents connect through. p2p migrate creates it with this password.
APP_DB_PASSWORD=change-me-local-only

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only

# Agents. offline needs no key or network; anthropic and ollama are opt-in.
LLM_PROVIDER=offline
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
