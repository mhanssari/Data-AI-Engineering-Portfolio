# Copy to .env (ignored by Git) and choose your own password. Nothing here is reachable beyond this machine.
POSTGRES_DB=payments
POSTGRES_USER=payments_admin
POSTGRES_PASSWORD=change-me-locally
# Port published on 127.0.0.1 for the CLI on the host and for the shared Airflow (host.docker.internal).
POSTGRES_PORT=55433
# Optional shared Airflow override: use a separate demo database, preserving the CLI's default database.
PAYRECON_AIRFLOW_DB=payments_airflow
