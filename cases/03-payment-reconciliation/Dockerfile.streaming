# Opt-in runtime only. The batch image and Airflow do not install the streaming dependency group.
FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM python:3.12.16-slim-trixie
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" /opt/java
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH \
    JAVA_HOME=/opt/java \
    SPARK_LOCAL_IP=127.0.0.1 \
    PYSPARK_PYTHON=/opt/venv/bin/python \
    PYTHONUNBUFFERED=1 \
    TZ=UTC
WORKDIR /app
COPY pyproject.toml uv.lock .python-version README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --group streaming --no-install-project
COPY streaming/ivysettings.xml /opt/ivysettings.xml
# Resolve connector dependencies at build time. Runtime does not need Maven access.
RUN python -c "from pyspark.sql import SparkSession; s=SparkSession.builder.master('local[1]').config('spark.ui.enabled','false').config('spark.jars.ivy','/opt/ivy').config('spark.jars.ivySettings','/opt/ivysettings.xml').config('spark.jars.packages','org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.1').getOrCreate(); print('Spark runtime:',s.version); s.stop()"
RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --create-home app \
    && mkdir -p /state && chown app:app /app /state
COPY --chown=app:app . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --group streaming
USER app
ENTRYPOINT ["payrecon"]
CMD ["--help"]
